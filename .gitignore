# Secrets -- never commit these. `.env.example` documents the shape; `.env` holds real values.
.env
.env.*
!**/.env.example

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Test / lint caches and coverage artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local databases. The demo data is regenerated by `python scripts/bootstrap_dev.py`.
data/
*.db
*.sqlite
*.sqlite3
backups/

# Generated eval output. Regenerate with `python evaluation/run_eval.py`.
evaluation/latest_report.json

# Tool-internal agent state (work logs, session caches). Not project content.
.workbuddy-ai/
.cursor/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
