# ---------------------------------------------------------------------------
# docker-compose overlay for `deployment/docker-compose.yml`.
#
# This is NOT a second source of truth. The complete, test-enforced list of application
# settings lives in the repository-root `.env.example`; `tests/test_config_docs.py` fails if
# that file and `app/config.py` disagree.
#
# This file contains only:
#   (a) the infrastructure variables compose itself needs (POSTGRES_*, GRAFANA_*), and
#   (b) the handful of application settings that must differ inside the compose network.
#
# Usage: copy the root `.env.example` and this file into `deployment/.env`, which compose
#        reads via `env_file: .env`.
# ---------------------------------------------------------------------------

# --- Compose infrastructure -------------------------------------------------
POSTGRES_DB=freight
POSTGRES_USER=freight
POSTGRES_PASSWORD=freight
GRAFANA_ADMIN_PASSWORD=change-me

# --- Application overrides for the compose network --------------------------
# Postgres instead of the SQLite default, and MailHog instead of the log-only mock.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://freight:freight@postgres:5432/freight
EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=ops@example.test

# --- Auth -------------------------------------------------------------------
# `dev` trusts the X-Demo-* headers. Switch to `jwt` and set a real secret before exposing
# this stack to anything reachable.
AUTH_MODE=dev
JWT_SECRET=change-this-long-secret
JWT_ISSUER=freight-agent-platform
APP_API_KEY=dev-api-key
WEBHOOK_SECRET=dev-webhook-secret

# --- Agent runtime ----------------------------------------------------------
# `mock` needs no credentials. For a real model, install requirements-agent.txt and set
# AGENT_PROVIDER=maf_openai plus OPENAI_CHAT_MODEL. OPENAI_API_KEY is read by the Agent
# Framework client itself, not by app/config.py -- which is why it is absent from the
# root .env.example.
AGENT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# --- Providers --------------------------------------------------------------
# All mock by default: the compose stack runs end-to-end with no external accounts.
SCHEDULE_PROVIDER=mock
DCSA_SCHEDULE_BASE_URL=
DCSA_SCHEDULE_TOKEN=
BOOKING_PROVIDER=mock
DCSA_BOOKING_BASE_URL=
DCSA_BOOKING_TOKEN=
TRACKING_PROVIDER=mock
DCSA_TRACKING_BASE_URL=
DCSA_TRACKING_TOKEN=
RATE_PROVIDER=mock
RATE_CONTRACT_BASE_URL=
RATE_CONTRACT_TOKEN=
RATE_INDEX_BASE_URL=
RATE_INDEX_TOKEN=
PROSPECTING_PROVIDER=mock
PROSPECTING_BASE_URL=
PROSPECTING_TOKEN=
VESSEL_PROVIDER=mock
AIS_BASE_URL=
AIS_TOKEN=

# --- Pricing / worker -------------------------------------------------------
DEFAULT_MARGIN_PCT=0.12
MINIMUM_MARGIN_USD=180.0
QUOTE_VALID_DAYS=7
MIN_SUPPLIER_QUOTES=2
WORKER_POLL_SECONDS=15
RFQ_TIMEOUT_HOURS=8

# --- Outreach compliance ----------------------------------------------------
OUTREACH_MAX_PER_WINDOW=2
OUTREACH_WINDOW_DAYS=30
OUTREACH_REQUIRES_HUMAN_APPROVAL=true

# --- Vessel -----------------------------------------------------------------
VESSEL_DELAY_ALERT_HOURS=12.0
