# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Every field below maps 1:1 to `app/config.py`.
# Names are case-insensitive; UPPER_SNAKE is the convention.
#
# `tests/test_config_docs.py` fails if a field is added to Settings without being
# documented here, so this file cannot silently drift.
#
# The defaults are the DEMO defaults: everything runs with mock providers and no
# credentials. You only need to fill in the credentials for providers you switch on.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_NAME="AI Freight Forwarder Multi-Agent Platform"
# development | staging | production
# In `production` the demo UI is not mounted and startup does not auto-create tables.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/freight.db

# --- Auth -------------------------------------------------------------------
# dev = trust the X-Demo-User / X-Demo-Tenant headers (DEMO ONLY).
# jwt = require a signed HS256 bearer token. Never ship `dev` to production.
AUTH_MODE=dev
JWT_SECRET=change-me-in-production
JWT_ISSUER=freight-agent-platform
APP_API_KEY=dev-api-key
# Validates inbound tracking webhooks when AUTH_MODE != dev.
WEBHOOK_SECRET=dev-webhook-secret

# --- Agent runtime ----------------------------------------------------------
# mock = deterministic, no LLM, no API key. Runs the whole state machine offline.
# maf_openai = Microsoft Agent Framework backed by an OpenAI chat model.
AGENT_PROVIDER=mock
# Required only when AGENT_PROVIDER=maf_openai. Leave blank to use the client default.
OPENAI_CHAT_MODEL=

# --- Email (outbound quotes, RFQs, outreach) --------------------------------
# mock = writes to the log instead of sending. smtp = real delivery.
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ops@example.test

# --- Ocean schedules (DCSA) -------------------------------------------------
SCHEDULE_PROVIDER=mock
DCSA_SCHEDULE_BASE_URL=
DCSA_SCHEDULE_TOKEN=

# --- Booking (DCSA) ---------------------------------------------------------
BOOKING_PROVIDER=mock
DCSA_BOOKING_BASE_URL=
DCSA_BOOKING_TOKEN=

# --- Container tracking (DCSA) ----------------------------------------------
TRACKING_PROVIDER=mock
DCSA_TRACKING_BASE_URL=
DCSA_TRACKING_TOKEN=

# --- Rate intelligence ------------------------------------------------------
# mock      = deterministic synthetic rates. Safe for demos and tests.
# contract  = your contracted carrier rates (licensed data, needs credentials).
# index     = a market index feed (licensed data, needs credentials).
# Providers return COST ONLY. Sell price is computed by the pricing engine and is
# never sourced from a provider -- see docs/INTEGRATIONS.md.
RATE_PROVIDER=mock
RATE_CONTRACT_BASE_URL=
RATE_CONTRACT_TOKEN=
RATE_INDEX_BASE_URL=
RATE_INDEX_TOKEN=

# --- Pricing ----------------------------------------------------------------
# Sell price = cost + max(MINIMUM_MARGIN_USD, cost * DEFAULT_MARGIN_PCT).
DEFAULT_MARGIN_PCT=0.12
MINIMUM_MARGIN_USD=180.0
QUOTE_VALID_DAYS=7
# A quote must be built from at least this many supplier quotes.
MIN_SUPPLIER_QUOTES=2

# --- Worker -----------------------------------------------------------------
# How often the follow-up scheduler polls for due tasks.
WORKER_POLL_SECONDS=15
# How long an RFQ may stay open before it is considered timed out.
RFQ_TIMEOUT_HOURS=8

# --- Prospecting / cold outreach --------------------------------------------
# mock = synthetic candidate list. No scraping, no third-party data.
PROSPECTING_PROVIDER=mock
PROSPECTING_BASE_URL=
PROSPECTING_TOKEN=
PROSPECT_DEFAULT_LIMIT=20
# Frequency cap: at most OUTREACH_MAX_PER_WINDOW messages per prospect per window.
OUTREACH_MAX_PER_WINDOW=2
OUTREACH_WINDOW_DAYS=30
# Cold outreach always requires a recorded lawful basis and a human approval step.
# Turning this off does not remove the compliance gate in the service layer.
OUTREACH_REQUIRES_HUMAN_APPROVAL=true

# --- Vessel position (AIS) --------------------------------------------------
# AIS is licensed paid data. The mock provider is synthetic.
VESSEL_PROVIDER=mock
AIS_BASE_URL=
AIS_TOKEN=
# A delay beyond this threshold raises a proactive customer notification task.
VESSEL_DELAY_ALERT_HOURS=12.0
